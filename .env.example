# =============================================================================
# BINANCE MARKET ANALYZER - READ-ONLY CONFIGURATION
# =============================================================================
# Copy this file to .env and adjust values.
# Never store real secrets in source control.
# =============================================================================

TRADING_MODE=analysis_only
PAPER_TRADING=false

# Public market analysis works without Binance credentials.
BINANCE_API_KEY=
BINANCE_API_SECRET=

SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
SYMBOL=BNBUSDT
BASE_ASSET=BNB
QUOTE_ASSET=USDT

CONTEXT_TIMEFRAME=4h
CONFIRMATION_TIMEFRAME=1h
SETUP_TIMEFRAME=15m
REFINEMENT_TIMEFRAME=5m
TIMEFRAME=15m
CHECK_INTERVAL=180
KLINE_LIMIT=250
ALERT_COOLDOWN_SECONDS=900

MAX_SPREAD_FILTER=0.003
MIN_VOLUME_RATIO=0.50
MIN_QUOTE_VOLUME_USDT=100000
MAX_VOLATILITY_FILTER=0.05
MIN_RISK_REWARD=2
STOP_LOSS_PERCENT=0.02
MIN_CONFIDENCE=0.60

RSI_PERIOD=14
MA_SHORT=9
MA_MEDIUM=21
MA_LONG=50
MA_TREND=200
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

LOG_FILE=market_analyzer.log
DB_PATH=trading_bot.db
HEALTH_CHECK_FILE=health_check.json

# Informational alerts only. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
